{
  "name": "Komari-Farmer",
  "short": "Komari-Farmer",
  "description": "Pixel-art farm theme for Komari Monitor — four seasons of farm scenery, wood-plank cards, pixel fonts",
  "version": "3.4.1",
  "author": "Neko",
  "url": "https://github.com/nekomini88/komari-theme-farmer",
  "preview": "preview.png",
  "configuration": {
    "type": "managed",
    "name": "Komari-Farmer 设置",
    "data": [
      {
        "name": "基础设置",
        "type": "title"
      },
      {
        "key": "dataUpdateInterval",
        "name": "数据更新间隔",
        "type": "number",
        "default": 3,
        "help": "实时数据刷新间隔，单位：秒（建议 1-10 秒）"
      },
      {
        "key": "rpcTransportMode",
        "name": "RPC 连接模式",
        "type": "select",
        "default": "websocket",
        "options": "websocket,http",
        "help": "RPC 默认连接模式，推荐使用 websocket，若您无法使用 websocket 请选择 http"
      },
      {
        "key": "defaultViewMode",
        "name": "默认视图模式",
        "type": "select",
        "default": "card",
        "options": "card,list",
        "help": "节点列表的默认显示模式"
      },
      {
        "name": "公告设置",
        "type": "title"
      },
      {
        "key": "alertEnabled",
        "name": "启用公告",
        "type": "switch",
        "default": false,
        "help": "在首页显示自定义公告"
      },
      {
        "key": "alertTitle",
        "name": "公告标题",
        "type": "string",
        "default": "",
        "help": "公告的标题内容"
      },
      {
        "key": "alertContent",
        "name": "公告内容",
        "type": "richtext",
        "default": "",
        "help": "公告的详细内容（支持简单 Markdown 格式）"
      },
      {
        "name": "页面设置",
        "type": "title"
      },
      {
        "name": "主题设置",
        "type": "title"
      },
      {
        "key": "themeSelection",
        "name": "主题选择",
        "type": "select",
        "default": "emerald",
        "options": "emerald,sunrise,green-mountain,blue-water,night,material-indigo,material-pink,material-teal",
        "help": "选择网站的主题颜色"
      },
      {
        "key": "themeVisualStyle",
        "name": "主题视觉风格",
        "type": "select",
        "default": "farmer",
        "options": "farmer,baseline",
        "help": "选择整体 UI 视觉风格：本主题的农场像素风格或默认风格。部分选项需要浏览器支持 CSS 变量。"
      },
      {
        "key": "stopEarth",
        "name": "停止地球旋转",
        "type": "switch",
        "default": false,
        "help": "开启后地球默认不自动旋转，用户仍可手动拖拽查看"
      },
      {
        "key": "hideEarth",
        "name": "隐藏地球",
        "type": "switch",
        "default": false,
        "help": "隐藏地球后仅显示总览卡片"
      },
      {
        "key": "hideGeneralCard",
        "name": "隐藏头部",
        "type": "switch",
        "default": false,
        "help": "隐藏地球和总览卡片"
      },
      {
        "key": "summaryCards",
        "name": "总览卡片选择",
        "type": "string",
        "default": "memory,disk,finance,traffic,speedUp,speedDown",
        "help": "自定义显示哪 6 个总览卡片，可选：memory(内存), disk(硬盘), finance(剩余价值), traffic(累计流量), speedUp(实时上行), speedDown(实时下行), connections(连接数)。用英文逗号分隔，选择 6 个"
      },
      {
        "key": "nodeCardMinWidth",
        "name": "节点卡片最小宽度",
        "type": "number",
        "default": 300,
        "help": "节点卡片的最小宽度（单位：px），数值越大卡片越宽，默认 300"
      },
      {
        "key": "showNodeConnections",
        "name": "显示节点连接数",
        "type": "switch",
        "default": true,
        "help": "在节点卡片上显示 TCP/UDP 连接数"
      },
      {
        "key": "showNodeUptime",
        "name": "显示在线时长",
        "type": "switch",
        "default": true,
        "help": "在节点卡片上显示服务器在线时长"
      },
      {
        "key": "visitorInfoCardEnabled",
        "name": "访客信息卡片",
        "type": "switch",
        "default": true,
        "help": "显示访客来源、设备和浏览器信息卡片"
      },
      {
        "key": "hideAdminEntryWhenLoggedOut",
        "name": "隐藏后台入口",
        "type": "switch",
        "default": false,
        "help": "未登录时隐藏顶部后台管理入口"
      },
      {
        "key": "disablePageAnimation",
        "name": "减弱过渡动画",
        "type": "switch",
        "default": false,
        "help": "减少页面过渡动画效果，提升访问速度和响应性"
      },
      {
        "key": "enableGlassEffect",
        "name": "毛玻璃特效",
        "type": "switch",
        "default": true,
        "help": "开启全局 iOS 风格毛玻璃效果，关闭可提升低端设备性能"
      },
      {
        "name": "备案设置",
        "type": "title"
      },
      {
        "key": "icpEnabled",
        "name": "显示备案号",
        "type": "switch",
        "default": false,
        "help": "在页脚显示网站备案号"
      },
      {
        "key": "icpNumber",
        "name": "备案号",
        "type": "string",
        "default": "",
        "help": "网站备案号（如：京ICP备12345678号）"
      },
      {
        "key": "icpUrl",
        "name": "备案跳转链接",
        "type": "string",
        "default": "https://beian.miit.gov.cn/",
        "help": "点击备案号跳转的链接地址"
      },
      {
        "key": "policeEnabled",
        "name": "显示公安备案",
        "type": "switch",
        "default": false,
        "help": "在页脚显示公安备案信息"
      },
      {
        "key": "policeNumber",
        "name": "公安备案号",
        "type": "string",
        "default": "",
        "help": "公安备案号（如：京公网安备 11010502000000号）"
      },
      {
        "key": "policeUrl",
        "name": "公安备案跳转链接",
        "type": "string",
        "default": "",
        "help": "点击公安备案号跳转的链接地址，留空则不跳转"
      },
      {
        "name": "自定义背景",
        "type": "title"
      },
      {
        "key": "backgroundEnabled",
        "name": "启用自定义背景",
        "type": "switch",
        "default": false,
        "help": "启用后可设置自定义图片或视频作为页面背景"
      },
      {
        "key": "backgroundType",
        "name": "背景类型",
        "type": "select",
        "default": "image",
        "options": "image,video",
        "help": "选择背景类型：图片或视频"
      },
      {
        "key": "lightBackgroundUrl",
        "name": "亮色模式背景地址",
        "type": "string",
        "default": "",
        "help": "亮色模式下的背景图片/视频 URL"
      },
      {
        "key": "darkBackgroundUrl",
        "name": "暗色模式背景地址",
        "type": "string",
        "default": "",
        "help": "暗色模式下的背景图片/视频 URL"
      },
      {
        "key": "backgroundBlur",
        "name": "背景模糊半径",
        "type": "number",
        "default": 0,
        "help": "背景的高斯模糊半径（单位：px），0 表示不模糊"
      },
      {
        "key": "backgroundOverlay",
        "name": "背景遮罩强度",
        "type": "number",
        "default": 0,
        "help": "背景遮罩强度（-100 到 100）：负数降低背景透明度，0 表示关闭，正数为黑色遮罩，绝对值越大效果越明显"
      },
      {
        "name": "场景世界（时间 / 季节 / 天气）",
        "type": "title"
      },
      {
        "key": "sceneTimeMode",
        "name": "时间来源",
        "type": "select",
        "default": "auto",
        "options": "auto,fixed",
        "help": "auto = 跟随我们的时间（UTC+8，取自服务端时钟，与访客本地时区无关）；fixed = 固定为下面选定的时段"
      },
      {
        "key": "sceneFixedTime",
        "name": "固定时段",
        "type": "select",
        "default": "day",
        "options": "day,dusk,night",
        "help": "仅当「时间来源」选 fixed 时生效：day=白天、dusk=黄昏、night=夜间"
      },
      {
        "key": "sceneSeasonMode",
        "name": "季节来源",
        "type": "select",
        "default": "auto",
        "options": "auto,fixed",
        "help": "auto = 跟随我们的时间自动换季；fixed = 固定为下面选定的季节"
      },
      {
        "key": "sceneFixedSeason",
        "name": "固定季节",
        "type": "select",
        "default": "spring",
        "options": "spring,summer,autumn,winter",
        "help": "仅当「季节来源」选 fixed 时生效：spring=春、summer=夏、autumn=秋、winter=冬"
      },
      {
        "key": "weatherMode",
        "name": "天气",
        "type": "select",
        "default": "auto",
        "options": "off,auto,fixed",
        "help": "off = 关闭天气（恒为晴）；auto = 每天按日期确定性随机（晴占多数、季节自洽）；fixed = 固定为下面选定的天气"
      },
      {
        "key": "weatherFixed",
        "name": "固定天气",
        "type": "select",
        "default": "clear",
        "options": "clear,rain,snow,wind,fog",
        "help": "仅当「天气」选 fixed 时生效：clear=晴、rain=雨、snow=雪、wind=大风、fog=雾"
      }
    ]
  }
}
